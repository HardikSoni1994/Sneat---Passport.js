<%- include('../layouts/header') %>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"> Add Sub Category</h4>

    <div class="row">
      <div class="col-xl">
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Add New Sub Category</h5>
            <a href="/subCategory/viewSubCategory" class="btn btn-secondary">View Categories</a>
          </div>
          <div class="card-body">
            
            <form action="/subcategory/insertSubCategory" method="POST">
              
              <div class="mb-3">
                <label class="form-label" for="category">Select Category</label>
                <select class="form-select" name="category_id" required>
                  <option value="">-- Select Category --</option>
                  
                  <% categories.forEach((cat) => { %>
                    <option value="<%= cat._id %>"><%= cat.category_name %></option>
                  <% }) %>

                </select>
              </div>

              <div class="mb-3">
                <label class="form-label" for="subCategory_name">Sub Category Name</label>
                <input type="text" class="form-control" name="subCategory_name" placeholder="Ex: Mobile, Laptop, Shirt..." required />
              </div>

              <button type="submit" class="btn btn-primary">Add Sub Category</button>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>