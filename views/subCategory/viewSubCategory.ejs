<%- include('../layouts/header') %>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0"> View Sub Category </h4>
        <a href="/subCategory/addSubCategory" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bx bx-plus me-1"></i> Add New Sub Category
        </a>
    </div>

    <style>
      .cat-card {
        border: none;
        border-radius: 16px; /* Perfect Rounded Corners */
        background: #fff;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
      }

      /* Image Box */
      .cat-img-box {
        height: 180px; 
        width: 100%;
        position: relative;
        overflow: hidden;
        background-color: #f8f9fa;
      }

      .cat-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
      }

      /* Content Body */
      .card-body {
        padding: 15px;
        text-align: center;
        background: #fff;
        position: relative;
        z-index: 2;
      }

      .cat-title {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 10px; /* Thoda gap kam kiya subtitle ke liye */
        color: #888;
        letter-spacing: 0.3px;
      }

      .parent-cat {
        font-size: 12px;
        color: #333;
        display: block;
        margin-bottom: 6px;
        font-weight: bold;
        text-transform: uppercase;
      }

      /* Hover Effects */
      .cat-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(105, 108, 255, 0.3);
      }

      .cat-card:hover .cat-img-box img {
        /* transform: scale(1.1); */
        transform: scale(1.15) rotate(2deg);
      }

      /* Buttons */
     .action-btn-group {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 10px;
      }
      
      .modern-btn {
        border-radius: 12px;
        padding: 8px 16px;
        font-weight: 600;
        border: none;
        transition: 0.3s;
      }
      .btn-soft-edit {
        background: rgba(105, 108, 255, 0.1);
        color: #696cff;
      }
      .btn-soft-edit:hover {
        background: #696cff;
        color: #fff;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(105, 108, 255, 0.4);
      }
      .btn-soft-delete {
        background: rgba(255, 62, 29, 0.1);
        color: #ff3e1d;
      }
      .btn-soft-delete:hover {
        background: #ff3e1d;
        color: #fff;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(255, 62, 29, 0.4);
      }

    </style>

    <div class="row">

      <% if (subCategories && subCategories.length > 0) { %>
    
    <% subCategories.forEach((item) => { %>
      <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-5"> 
        <div class="card cat-card h-100">
          <div class="cat-img-box">
            <img src="/uploads/subCategories/<%= item.subCategory_image %>" alt="subCategory">
          </div>
          <div class="card-body text-center">
            <h5 class="fw-bold mb-1 text-dark" style="letter-spacing: 0.5px;"><%= item.subCategory_name %></h5>
            
           <div class="action-btn-group">
              <a href="/subCategory/editSubCategory/<%= item._id %>" class="modern-btn btn-soft-edit">
                <i class="bx bx-edit-alt"></i> Edit
              </a>
              <a href="/subCategory/deleteSubCategory/<%= item._id %>" class="modern-btn btn-soft-delete" >
                <i class="bx bx-trash"></i> Delete
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>

  <% } else { %>
    
    <div class="col-12 text-center py-5">
      <i class="bx bx-folder-open text-muted mb-3" style="font-size: 5rem; opacity: 0.5;"></i>
      <h4 class="fw-bold text-muted">No Sub Categories Found!</h4>
    </div>

  <% } %>
    </div>

  </div>
</div>

<%- include('../layouts/footer') %>