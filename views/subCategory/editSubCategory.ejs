<%- include('../layouts/header') %>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"> Edit Sub Category</h4>

    <div class="row">
      <div class="col-xl">
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Edit Sub Category</h5>
          </div>
          <div class="card-body">
            
            <form action="/subcategory/updateSubCategory" method="POST">
              
              <input type="hidden" name="id" value="<%= singleSubCategory._id %>">

              <div class="mb-3">
                <label class="form-label">Select Parent Category</label>
                <select class="form-select" name="category_id" required>
                  <option value="">-- Select Category --</option>
                  
                  <% categories.forEach((cat) => { %>
                    <option value="<%= cat._id %>" 
                        <% if(cat._id.toString() == singleSubCategory.category_id.toString()) { %> selected <% } %> 
                    >
                        <%= cat.category_name %>
                    </option>
                  <% }) %>

                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Sub Category Name</label>
                <input type="text" class="form-control" name="subCategory_name" 
                       value="<%= singleSubCategory.subCategory_name %>" required />
              </div>

              <button type="submit" class="btn btn-primary">Update Sub Category</button>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>