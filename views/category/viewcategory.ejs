<%- include('../layouts/header') %>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h4 class="fw-bold py-3 mb-0" style="font-family: 'Poppins', sans-serif;"> View Category</h4>
        <a href="/category/addCategory" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bx bx-plus me-1"></i> Add New Category
        </a>
    </div>

    <style>
      .cat-card {
        border: none;
        border-radius: 24px;
        background: #fff;
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }
      .cat-img-box {
        height: 220px;
        width: 100%;
        position: relative;
        background: #f8f9fa;
        overflow: hidden;
      }

      .cat-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
      }

      /* Content Area */
      .card-body {
        padding: 1.5rem;
        background: #fff;
        z-index: 2;
        position: relative;
      }
      .cat-card:hover {
        transform: translateY(-12px) scale(1.02);
        box-shadow: 0 20px 60px rgba(105, 108, 255, 0.4); 
      }

      /* Image Zoom on Hover */
      .cat-card:hover .cat-img-box img {
        transform: scale(1.15) rotate(2deg);
      }
      .cat-img-box::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 50%;
        background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
        opacity: 0;
        transition: 0.4s;
      }
      .cat-card:hover .cat-img-box::after {
        opacity: 1;
      }
      .action-btn-group {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 10px;
      }
      
      .modern-btn {
        border-radius: 12px;
        padding: 8px 16px;
        font-weight: 600;
        border: none;
        transition: 0.3s;
      }
      .btn-soft-edit {
        background: rgba(105, 108, 255, 0.1);
        color: #696cff;
      }
      .btn-soft-edit:hover {
        background: #696cff;
        color: #fff;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(105, 108, 255, 0.4);
      }
      .btn-soft-delete {
        background: rgba(255, 62, 29, 0.1);
        color: #ff3e1d;
      }
      .btn-soft-delete:hover {
        background: #ff3e1d;
        color: #fff;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(255, 62, 29, 0.4);
      }

    </style>

    <div class="row">
      
      <!-- <% categoryData.forEach((item) => { %>
        
        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-5"> <div class="card cat-card h-100">
            
            <div class="cat-img-box">
              <img src="/uploads/categories/<%= item.category_image %>" alt="Category">
            </div>

            <div class="card-body text-center">
              <h5 class="fw-bold mb-1 text-dark" style="letter-spacing: 0.5px;"><%= item.category_name %></h5>
              <div class="action-btn-group">
                <a href="/category/editCategory/<%= item._id %>" class="modern-btn btn-soft-edit">
                  <i class="bx bx-edit-alt"></i> Edit
                </a>
                <a href="/category/deleteCategory/<%= item._id %>" class="modern-btn btn-soft-delete" >
                  <i class="bx bx-trash"></i> Delete
                </a>
              </div>

            </div>
          </div>
        </div>

      <% }) %> -->

      <div class="row">
      
  <% if (categoryData && categoryData.length > 0) { %>
    
    <% categoryData.forEach((item) => { %>
      <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-5"> 
        <div class="card cat-card h-100">
          <div class="cat-img-box">
            <img src="/uploads/categories/<%= item.category_image %>" alt="Category">
          </div>
          <div class="card-body text-center">
            <h5 class="fw-bold mb-1 text-dark" style="letter-spacing: 0.5px;"><%= item.category_name %></h5>
            <div class="action-btn-group">
              <a href="/category/editCategory/<%= item._id %>" class="modern-btn btn-soft-edit">
                <i class="bx bx-edit-alt"></i> Edit
              </a>
              <a href="/category/deleteCategory/<%= item._id %>" class="modern-btn btn-soft-delete" >
                <i class="bx bx-trash"></i> Delete
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>

  <% } else { %>
    
    <div class="col-12 text-center py-5">
      <i class="bx bx-folder-open text-muted mb-3" style="font-size: 5rem; opacity: 0.5;"></i>
      <h4 class="fw-bold text-muted">No Categories Found!</h4>
    </div>

  <% } %>

</div>

    </div>

  </div>
</div>

