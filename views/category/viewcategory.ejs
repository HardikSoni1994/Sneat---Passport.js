<%- include('../layouts/header') %>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    
    <h4 class="fw-bold py-3 mb-4">View Category</h4>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Category List</h5>
        <a href="/category/addCategory" class="btn btn-primary">Add New Category</a>
      </div>
      
      <div class="table-responsive text-nowrap">
        <table class="table">
         <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Model</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
</thead>
         <tbody class="table-border-bottom-0">
  <% categoryData.map((item, index) => { %>
    <tr>
      <td><strong><%= item.category_name %></strong></td>
      
      <td>$<%= item.category_price %></td>

      <td><%= item.category_model %></td>

      <td>
        <img src="/uploads/categories/<%= item.category_image %>" width="70" alt="img">
      </td>

      <td>
        <a href="/category/editCategory/<%= item._id %>" class="btn btn-primary btn-sm me-1 text-white">Edit</a>
        <a href="/category/deleteCategory/<%= item._id %>" class="btn btn-danger btn-sm text-white">Delete</a>
      </td>
    </tr>
  <% }) %>
</tbody>
        </table>
      </div>
    </div>
    </div>
</div>

<%- include('../layouts/footer') %>