<!DOCTYPE html>
<html lang="en" class="light-style customizer-hide" dir="ltr" data-theme="theme-default">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forget Password | Sneat Admin</title>
    <link rel="stylesheet" href="/assets/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="/assets/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />
    <link rel="stylesheet" href="/assets/vendor/css/pages/page-auth.css" />
    
    <!-- Toastify CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.min.css">
  </head>

  <body>
    <div class="container-xxl">
      <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner py-4">
          <div class="card">
            <div class="card-body">
              <h4 class="mb-2">Forget Password? 🔒</h4>
              <p class="mb-4">Enter your email and we'll send you an OTP to reset your password</p>
              
              <form id="formAuthentication" class="mb-3" action="/send-otp" method="POST">
                <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input type="text" class="form-control" id="email" name="email" placeholder="Enter your email" autofocus required />
                </div>
                <button class="btn btn-primary d-grid w-100">Send OTP</button>
              </form>
              <div class="text-center">
                <a href="/" class="d-flex align-items-center justify-content-center">
                  <i class="bx bx-chevron-left scaleX-n1-rtl bx-sm"></i>
                  Back to login
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Toastify JS -->
    <script src="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.min.js"></script>
    
    <!-- Custom Toast Styles -->
    <style>
        .toastify {
            font-family: 'Public Sans', sans-serif !important;
            border-radius: 12px !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12) !important;
            backdrop-filter: blur(10px) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            font-weight: 500 !important;
            font-size: 14px !important;
            padding: 16px 20px !important;
            min-width: 300px !important;
            animation: slideInRight 0.4s ease-out !important;
        }
        
        @keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
    </style>
    
    <!-- Flash Messages Script -->
    <% if (locals.flash && flash.success && flash.success.length > 0) { %>
    <script>
        Toastify({
            text: "✅ <%= flash.success[0] %>",
            duration: 4000,
            gravity: "top",
            position: "right",
            stopOnFocus: true,
            style: {
                background: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
                borderRadius: "12px",
                boxShadow: "0 8px 32px rgba(79, 172, 254, 0.3)",
                border: "1px solid rgba(255, 255, 255, 0.3)",
                backdropFilter: "blur(10px)",
                fontFamily: "'Public Sans', sans-serif",
                fontWeight: "600",
                fontSize: "14px",
                padding: "16px 20px",
                minWidth: "320px",
                textAlign: "left"
            },
            onClick: function(){}
        }).showToast();
    </script>
    <% } %>
    
    <% if (locals.flash && flash.error && flash.error.length > 0) { %>
    <script>
        Toastify({
            text: "❌ <%= flash.error[0] %>",
            duration: 4000,
            gravity: "top",
            position: "right",
            stopOnFocus: true,
            style: {
                background: "linear-gradient(135deg, #fa709a 0%, #fee140 100%)",
                borderRadius: "12px",
                boxShadow: "0 8px 32px rgba(250, 112, 154, 0.3)",
                border: "1px solid rgba(255, 255, 255, 0.3)",
                backdropFilter: "blur(10px)",
                fontFamily: "'Public Sans', sans-serif",
                fontWeight: "600",
                fontSize: "14px",
                padding: "16px 20px",
                minWidth: "320px",
                textAlign: "left"
            },
            onClick: function(){}
        }).showToast();
    </script>
    <% } %>
  </body>
</html>