<%- include('../layouts/header') %>

<style>
  /* Premium Dashboard Cards CSS */
  .dash-card {
      border-radius: 12px;
      border: none;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
      transition: all 0.3s ease;
  }
  .dash-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 20px rgba(0, 0, 0, 0.12);
  }
  .dash-icon {
      width: 55px;
      height: 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
  }
  .dash-icon i {
      font-size: 1.8rem;
  }
  /* Custom bottom borders for extra pop */
  .border-b-primary { border-bottom: 4px solid #696cff; }
  .border-b-success { border-bottom: 4px solid #71dd37; }
  .border-b-warning { border-bottom: 4px solid #ffab00; }
  .border-b-info { border-bottom: 4px solid #03c3ec; }
</style>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">

    <div class="row mb-2">
  
  <div class="col-lg-3 col-md-6 col-12 mb-4">
    <div class="card dash-card border-b-primary">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <p class="mb-1 text-muted fw-semibold fs-6">Total Categories</p>
          <h2 class="mb-0 fw-bold text-dark"><%= categoryCount %></h2>
        </div>
        <div class="dash-icon bg-label-primary">
          <i class="bx bx-category"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-3 col-md-6 col-12 mb-4">
    <div class="card dash-card border-b-success">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <p class="mb-1 text-muted fw-semibold fs-6">Sub Categories</p>
          <h2 class="mb-0 fw-bold text-dark"><%= subCategoryCount %></h2>
        </div>
        <div class="dash-icon bg-label-success">
          <i class="bx bx-collection"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-3 col-md-6 col-12 mb-4">
    <div class="card dash-card border-b-warning">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <p class="mb-1 text-muted fw-semibold fs-6">Extra Categories</p>
          <h2 class="mb-0 fw-bold text-dark"><%= extraCategoryCount %></h2>
        </div>
        <div class="dash-icon bg-label-warning">
          <i class="bx bx-list-plus"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-3 col-md-6 col-12 mb-4">
    <div class="card dash-card border-b-info">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <p class="mb-1 text-muted fw-semibold fs-6">Total Products</p>
          <h2 class="mb-0 fw-bold text-dark"><%= productCount %></h2>
        </div>
        <div class="dash-icon bg-label-info">
          <i class="bx bx-box"></i>
        </div>
      </div>
    </div>
  </div>

</div>

<div class="row mt-4 mb-4">
  <div class="col-12">
    <div class="card">
      <h5 class="card-header border-bottom mb-2">Recently Added Products</h5>
      
      <div class="table-responsive text-nowrap">
        <table class="table table-hover">
          <thead class="table-light">
            <tr>
              <th>Image</th>
              <th>Category</th>
              <th>Product Name</th>
              <th>Price</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            
            <% if (recentProducts && recentProducts.length > 0) { %>
              <% recentProducts.forEach((item) => { %>
                <tr>
                  <td>
                    <div style="width: 45px; height: 45px; border-radius: 8px; overflow: hidden; border: 1px solid #eceef1;">
                      <img src="<%= item.product_image %>" alt="Product" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                  </td>
                  <td>
                    <!-- <span class="badge bg-primary me-1"><%= item.category_name ? item.category_name : 'N/A' %></span><br> -->
                    <span class="badge bg-primary"><%= item.category_id ? item.category_id.category_name : 'N/A' %></span>
                  </td>           
                  <td style="max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= item.product_name %>"><strong><%= item.product_name %></strong></td>
                  
                  <td>₹<%= item.product_price %></td>
                  
                  <td>
                    <span class="badge bg-success">New</span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center py-4">No products found. Start adding some!</td>
              </tr>
            <% } %>

          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

    <div class="row">
      
      <div class="col-lg-8 mb-4 order-0">
        <div class="card">
          <div class="d-flex align-items-end row">
            <div class="col-sm-7">
              <div class="card-body">
                <h5 class="card-title text-primary">Congratulations <%= admin.name %>! 🎉</h5>
                <p class="mb-4">
                  You have done <span class="fw-bold">72%</span> more sales today. Check your new badge in
                  your profile.
                </p>
                <a href="javascript:;" class="btn btn-sm btn-outline-primary">View Badges</a>
              </div>
            </div>
            <div class="col-sm-5 text-center text-sm-left">
              <div class="card-body pb-0 px-0 px-md-4">
                <img
                  src="<%= admin.image ? '/uploads/admins/' + admin.image : '/assets/img/avatars/1.png' %>"
                  height="140"
                  alt="Profile Photo"
                  data-app-dark-img="illustrations/man-with-laptop-dark.png"
                  data-app-light-img="illustrations/man-with-laptop-light.png"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4 col-md-4 order-1">
