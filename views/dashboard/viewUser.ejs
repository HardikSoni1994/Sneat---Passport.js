<%- include('../layouts/header') %>

<style>
  .modern-btn {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 35px !important;
      height: 35px !important;
      padding: 0 !important;
      border-radius: 8px !important;
      border: none !important;
      transition: all 0.3s ease;
      text-decoration: none !important;
  }

  /* Icon Size Control */
  .modern-btn i {
      font-size: 1.2rem !important;
      line-height: 0 !important;
  }

  /* EDIT Button (Light Blue Theme) */
  .btn-edit {
      background-color: rgba(105, 108, 255, 0.15) !important;
      color: #696cff !important;
  }
  
  .btn-edit:hover {
      background-color: #696cff !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(105, 108, 255, 0.4);
  }

  /* DELETE Button (Light Red Theme) */
  .btn-delete {
      background-color: rgba(255, 62, 29, 0.15) !important;
      color: #ff3e1d !important;
  }
  
  .btn-delete:hover {
      background-color: #ff3e1d !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(255, 62, 29, 0.4);
  }
</style>
<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">User Management</h4>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">User List</h5>
          <a href="/addUser" class="btn btn-primary">Add New User</a>
      </div>

      <div class="table-responsive text-nowrap">
        <table class="table" id="myTable">
          <thead>
            <tr>
              <th>Image</th>
              <th>Username</th>
              <th>Email</th>
              <th>Phone No.</th>
              <th>City</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
                 
              <% if (data && data.length > 0) { %>
    
    <% data.forEach((val, index) => { %>
      <tr style="vertical-align: middle;">
        <td>
          <div style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden;">
            <img src="/uploads/Users/<%= val.user_image %>" alt="User" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
        </td>
        <td><strong><%= val.username %></strong></td>
        <td><%= val.email %></td>
        <td><%= val.phone %></td>
        <td><%= val.city %></td>
        <td>
          <a href="/edit-user/<%= val._id %>" class="modern-btn btn-edit"><i class="bx bx-edit-alt"></i></a>
          <a href="/delete-user/<%= val._id %>" class="modern-btn btn-delete"><i class="bx bx-trash"></i></a>
        </td>
      </tr>
    <% }) %>

  <% } else { %>
    
    <tr>
      <td colspan="6" class="text-center py-5">
        <i class="bx bx-group text-muted mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
        <h5 class="fw-bold text-muted">No Users Found!</h5>
      </td>
    </tr>

  <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>