<%- include('../layouts/header') %>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">Add New Product</h4>

    <div class="row">
      <div class="col-xl">
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Product Details</h5>
            <a href="/product/viewProduct" class="btn btn-secondary">View Product</a>
          </div>
          <div class="card-body">
            
            <form action="/product/insertProduct" method="POST" enctype="multipart/form-data">
              
              <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Select Category</label>
                    <select class="form-select" name="category_id" id="category" onchange="categoryChange()" required>
                        <option value="">-- Select Category --</option>
                        <% categories.map((cat) => { %>
                            <option value="<%= cat._id %>"><%= cat.category_name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Select Sub Category</label>
                    <select class="form-select" name="subCategory_id" id="subCategory" onchange="subCategoryChange()" required>
                        <option value="">-- Select Sub Category --</option>
                        </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Select Extra Category</label>
                    <select class="form-select" name="extraCategory_id" id="extraCategory" required>
                        <option value="">-- Select Extra Category --</option>
                        </select>
                </div>
              </div>

              <div class="row mb-3">
                  <div class="col-md-6">
                      <label class="form-label">Product Name</label>
                      <input type="text" name="product_name" class="form-control" placeholder="Ex: Nike Air Max" required />
                  </div>
                  <div class="col-md-6">
                      <label class="form-label">Brand Name (Optional)</label>
                      <input type="text" name="product_brand" class="form-control" placeholder="Ex: Nike" />
                  </div>
              </div>

              <div class="row mb-3">
                  <div class="col-md-4">
                      <label class="form-label">Price (Selling Price)</label>
                      <input type="number" name="product_price" class="form-control" placeholder="Ex: 4999" required />
                  </div>
                  <div class="col-md-4">
                      <label class="form-label">Old Price (MRP)</label>
                      <input type="number" name="product_old_price" class="form-control" placeholder="Ex: 7999" />
                  </div>
                  <div class="col-md-4">
                      <label class="form-label">Quantity (Stock)</label>
                      <input type="number" name="product_qty" class="form-control" placeholder="Ex: 100" required />
                  </div>
              </div>

              <div class="mb-3">
                  <label class="form-label">Product Description</label>
                  <textarea name="product_desc" class="form-control" rows="3" placeholder="Enter product details..." required></textarea>
              </div>

              <div class="mb-3">
                  <label class="form-label">Product Image</label>
                  <input type="file" name="product_image" class="form-control" required />
              </div>

              <button type="submit" class="btn btn-primary">Add Product</button>
            </form>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

<script>
    const allSubCategories = <%- JSON.stringify(subCategories) %>;
    const allExtraCategories = <%- JSON.stringify(extraCategories) %>;

    function categoryChange() {
        const catId = document.getElementById("category").value;
        const subCatSelect = document.getElementById("subCategory");
        
        const filteredSub = allSubCategories.filter((item) => {
             return item.category_id == catId || item.category_id._id == catId;
        });

        let clutter = '<option value="">-- Select Sub Category --</option>';
        filteredSub.map((item) => {
            clutter += `<option value="${item._id}">${item.subCategory_name}</option>`;
        });
        subCatSelect.innerHTML = clutter;

        document.getElementById("extraCategory").innerHTML = '<option value="">-- Select Extra Category --</option>';
    }

    function subCategoryChange() {
        const subCatId = document.getElementById("subCategory").value;
        const extraCatSelect = document.getElementById("extraCategory");

        const filteredExtra = allExtraCategories.filter((item) => {
            return item.subCategory_id == subCatId || item.subCategory_id._id == subCatId;
        });

        let extraCategoryOption = '<option value="">-- Select Extra Category --</option>';
        filteredExtra.map((item) => {
            extraCategoryOption += `<option value="${item._id}">${item.extraCategory_name}</option>`;
        });
        extraCatSelect.innerHTML = extraCategoryOption;
    }
</script>