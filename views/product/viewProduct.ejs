<%- include('../layouts/header') %>

<style>
  .modern-btn {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 35px !important;
      height: 35px !important;
      padding: 0 !important;
      border-radius: 8px !important;
      border: none !important;
      transition: all 0.3s ease;
      text-decoration: none !important;
  }

  /* Icon Size Control */
  .modern-btn i {
      font-size: 1.2rem !important;
      line-height: 0 !important;
  }

  /* EDIT Button (Light Blue Theme) */
  .btn-edit {
      background-color: rgba(105, 108, 255, 0.15) !important;
      color: #696cff !important;
  }
  
  .btn-edit:hover {
      background-color: #696cff !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(105, 108, 255, 0.4);
  }

  /* DELETE Button (Light Red Theme) */
  .btn-delete {
      background-color: rgba(255, 62, 29, 0.15) !important;
      color: #ff3e1d !important;
  }
  
  .btn-delete:hover {
      background-color: #ff3e1d !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(255, 62, 29, 0.4);
  }
</style>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    
    <div class="d-flex justify-content-between align-items-center py-3 mb-4">
        <h4 class="fw-bold mb-0">View Products</h4>
        <a href="/product/addProduct" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add New Product
        </a>
    </div>

    <div class="card">
      <h5 class="card-header">Product List</h5>
      
      <div class="table-responsive text-nowrap">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>#</th>
              <th>Image</th>
              <th>Product Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Remark</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            
            <% products.map((item, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                
                <td>
                     <img src="<%= item.product_image %>" width="50" height="50" style="object-fit: contain;" />
                </td>

                <td>
                    <strong><%= item.product_name %></strong><br>
                    <small class="badge bg-label-dark text-dark"><%= item.product_brand %></small>
                </td>
                
                <td>
                    <span class="badge bg-primary me-1"><%= item.category_id ? item.category_id.category_name : 'N/A' %></span><br>
                    <small><%= item.subCategory_id ? item.subCategory_id.subCategory_name : '' %></small>
                </td>

                <td>
                    ₹<%= item.product_price %> 
                    <% if(item.product_old_price) { %>
                        <br><small class="text-danger text-decoration-line-through">₹<%= item.product_old_price %></small>
                    <% } %>
                </td>

                <td>
                    <span class="fw-bold"><%= item.product_qty %></span>
                </td>

                <td>
                    <% if(item.product_qty > 0) { %>
                        <span class="badge bg-success text-white">In Stock</span>
                    <% } else { %>
                        <span class="badge bg-danger text-white">Out of Stock</span>
                    <% } %>
                </td>

                <td>
                  <a href="/product/editProduct/?id=<%= item._id %>" class="modern-btn btn-edit"><i class="bx bx-edit-alt"></i></a>
                  <a href="/product/deleteProduct/?id=<%= item._id%>" class="modern-btn btn-delete"><i class="bx bx-trash"></i></a>
                </td>
              </tr>
            <% }) %>

          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>