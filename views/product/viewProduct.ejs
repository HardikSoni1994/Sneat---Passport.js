<%- include('../layouts/header') %>

<style>
  .my-custom-tooltip {
        position: relative;
        display: inline-block;
        cursor: pointer;
    }

    /* Tooltip ka Box (Dark & White Text) */
    .my-custom-tooltip .tooltip-box {
        visibility: hidden;
        width: 180px;
        background-color: #2b2c40;
        color: #ffffff;
        text-align: center;
        border-radius: 8px;
        padding: 8px, 10px;
        font-size: 11px;
        line-height: 1.5;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        white-space: normal !important; 
        word-wrap: break-word;
        position: absolute;
        z-index: 1050;
        top: 50%; 
        left: 100%;
        transform: translateY(-50%);
        margin-left: 12px;
        
        /* Smooth Animation */
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
    }

    .my-custom-tooltip .tooltip-box::after {
        content: "";
        position: absolute;
        right: 100%;
        left: auto;
        top: 50%;
        margin-top: -6px;
        border-width: 6px;
        border-style: solid;
        border-color: transparent #2b2c40 transparent  transparent;
    }

    /* Hover karne par Tooltip dikhao */
    .my-custom-tooltip:hover .tooltip-box {
        visibility: visible;
        opacity: 1;
    }
  .modern-btn {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 35px !important;
      height: 35px !important;
      padding: 0 !important;
      border-radius: 8px !important;
      border: none !important;
      transition: all 0.3s ease;
      text-decoration: none !important;
  }

  /* Icon Size Control */
  .modern-btn i {
      font-size: 1.2rem !important;
      line-height: 0 !important;
  }

  /* EDIT Button (Light Blue Theme) */
  .btn-edit {
      background-color: rgba(105, 108, 255, 0.15) !important;
      color: #696cff !important;
  }
  
  .btn-edit:hover {
      background-color: #696cff !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(105, 108, 255, 0.4);
  }

  /* DELETE Button (Light Red Theme) */
  .btn-delete {
      background-color: rgba(255, 62, 29, 0.15) !important;
      color: #ff3e1d !important;
  }
  
  .btn-delete:hover {
      background-color: #ff3e1d !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(255, 62, 29, 0.4);
  }

  /* Product Image ka naya premium container */
.product-img-wrapper {
    width: 75px;  /* Size thodi badi ki (pehle 60 thi) */
    height: 75px;
    border-radius: 12px; /* Soft rounded corners */
    overflow: hidden; /* Zoom effect ke liye zaroori */
    border: 2px solid #eceef1; /* Halka border frame jaisa */
    padding: 3px; /* Border aur image ke beech gap */
    background: #fff;
    box-shadow: 0 3px 8px rgba(0,0,0,0.08); /* Halki si shadow depth ke liye */
    transition: all 0.3s ease;
}

/* Image ko container ke andar fit karna */
.product-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Pura product dikhega, kateg nahi */
    border-radius: 8px; /* Inner rounding */
    transition: transform 0.3s ease; /* Smooth zoom animation */
}

/* Hover Effect: Mouse le jane par halka sa zoom aur highlight */
.product-img-wrapper:hover {
    border-color: #696cff; /* Sneat theme ka primary color */
    box-shadow: 0 5px 15px rgba(105, 108, 255, 0.2);
}

.product-img-wrapper:hover img {
    transform: scale(1.12); /* Image thodi zoom hogi */
}
</style>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    
    <div class="d-flex justify-content-between align-items-center py-3 mb-4">
        <h4 class="fw-bold mb-0">View Products</h4>
        <a href="/product/addProduct" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add New Product
        </a>
    </div>

    <div class="card">
      <h5 class="card-header">Product List</h5>
      
      <div class="table-responsive text-nowrap">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>#</th>
              <th>Image</th>
              <th>Product Name</th>
              <th>Description</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Remark</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            
            <% products.map((item, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                
                <td>
                  <div class="product-img-wrapper">
                      <img src="<%= item.product_image %>" alt="Product Image">
                  </div>
                </td>

                <td style="white-space: normal; max-width: 180px;">
                    <strong><%= item.product_name %></strong><br>
                    <small class="badge bg-label-dark text-dark"><%= item.product_brand %></small>
                </td>

                <td style="max-width: 150px; white-space: normal;">
                    <div class="my-custom-tooltip">
                      <small class="text-muted">
                          <%= item.product_desc && item.product_desc.length > 50 ? item.product_desc.substring(0, 50) + '...' : item.product_desc %>
                      </small>
                      
                      <span class="tooltip-box">
                          <%= item.product_desc %>
                      </span>
                  </div>
                </td>
                
                <td>
                    <span class="badge bg-primary me-1"><%= item.category_id ? item.category_id.category_name : 'N/A' %></span><br>
                    <small><%= item.subCategory_id ? item.subCategory_id.subCategory_name : '' %></small>
                </td>

                <td>
                    ₹<%= item.product_price %> 
                    <% if(item.product_old_price) { %>
                        <br><small class="text-danger text-decoration-line-through">₹<%= item.product_old_price %></small>
                    <% } %>
                </td>

                <td>
                    <span class="fw-bold"><%= item.product_qty %></span>
                </td>

                <td>
                    <% if(item.product_qty > 0) { %>
                        <span class="badge bg-success text-white">In Stock</span>
                    <% } else { %>
                        <span class="badge bg-danger text-white">Out of Stock</span>
                    <% } %>
                </td>

                <td>
                  <a href="/product/editProduct/?id=<%= item._id %>" class="modern-btn btn-edit"><i class="bx bx-edit-alt"></i></a>
                  <a href="/product/deleteProduct/?id=<%= item._id%>" class="modern-btn btn-delete"><i class="bx bx-trash"></i></a>
                </td>
              </tr>
            <% }) %>

          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>