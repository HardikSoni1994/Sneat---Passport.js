<%- include('../layouts/header') %>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">Add Extra Category</h4>

    <div class="row">
      <div class="col-xl">
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Create Extra Category</h5>
            <a href="/extraCategory/viewExtraCategory" class="btn btn-secondary">View Extra Categories</a>
          </div>
          <div class="card-body">
            
            <form action="/extraCategory/insertExtraCategory" method="POST" enctype="multipart/form-data">

              <div class="mb-3">
                <label class="form-label">Select Category</label>
                <select class="form-select" name="category_id" id="category" onchange="categoryChange()" required>
                  <option value="">-- Select Category --</option>
                  <% categories.forEach((cat) => { %>
                    <option value="<%= cat._id %>"><%= cat.category_name %></option>
                  <% }) %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Select Sub Category</label>
                <select class="form-select" name="subCategory_id" id="subCategory" required>
                  <option value="">-- Select Sub Category --</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Extra Category Name</label>
                <input type="text" name="extraCategory_name" class="form-control" placeholder="Ex: Canvas Shoes, V-Neck Tshirts" required />
              </div>

              <div class="mb-3">
                <label class="form-label">Extra Category Image</label>
                <input type="file" name="extraCategory_image" class="form-control" required />
              </div>

              <button type="submit" class="btn btn-primary">Add Extra Category</button>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

<script>
    const allSubCategories = <%- JSON.stringify(subCategories) %>;

    function categoryChange() {

        const catId = document.getElementById("category").value;
        const subCatSelect = document.getElementById("subCategory");

        subCatSelect.innerHTML = '<option value="">-- Select Sub Category --</option>';

        // 3. FILTER LOGIC
        const filteredSubCats = allSubCategories.filter((item) => {
            return item.category_id == catId;
        });

        var subCategoryOption = '<option value="">-- Select Sub Category --</option>';

        filteredSubCats.map((item) => {
        subCategoryOption += `<option value="${item._id}">${item.subCategory_name}</option>`;    
        });
        subCatSelect.innerHTML = subCategoryOption;
    }
</script>