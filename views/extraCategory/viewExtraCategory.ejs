<%- include('../layouts/header') %>

<style>
  .modern-btn {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 35px !important;
      height: 35px !important;
      padding: 0 !important;
      border-radius: 8px !important;
      border: none !important;
      transition: all 0.3s ease;
      text-decoration: none !important;
  }

  /* Icon Size Control */
  .modern-btn i {
      font-size: 1.2rem !important;
      line-height: 0 !important;
  }

  /* EDIT Button (Light Blue Theme) */
  .btn-edit {
      background-color: rgba(105, 108, 255, 0.15) !important;
      color: #696cff !important;
  }
  
  .btn-edit:hover {
      background-color: #696cff !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(105, 108, 255, 0.4);
  }

  /* DELETE Button (Light Red Theme) */
  .btn-delete {
      background-color: rgba(255, 62, 29, 0.15) !important;
      color: #ff3e1d !important;
  }
  
  .btn-delete:hover {
      background-color: #ff3e1d !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(255, 62, 29, 0.4);
  }

  /* Premium Image Frame (Same as Products) */
  .extracategory-img-wrapper {
      width: 70px;
      height: 70px;
      border-radius: 12px;
      overflow: hidden;
      border: 2px solid #eceef1;
      padding: 3px;
      background: #fff;
      box-shadow: 0 3px 8px rgba(0,0,0,0.08);
      transition: all 0.3s ease;
      margin: 0 auto;
  }

  .extracategory-img-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover; /* Photo box me fit ho jayegi */
      border-radius: 8px;
      transition: transform 0.3s ease;
  }

  .extracategory-img-wrapper:hover {
      /* border-color: #696cff; */
      box-shadow: 0 5px 15px rgba(105, 108, 255, 0.2);
  }

  .extracategory-img-wrapper:hover img {
      transform: scale(1.15); /* Zoom Effect */
  }
</style>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center py-3 mb-4">
      <h4 class="fw-bold mb-0">View Extra Categories</h4>
      <a href="/extraCategory/addExtraCategory" class="btn btn-primary">Add New Extra Category</a>
    </div>


    <div class="card">
      <h5 class="card-header">Extra Category List</h5>
      
      <div class="table-responsive text-nowrap">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>SR.No</th>
              <th>Category Name</th>
              <th>Sub Category Name</th>
              <th>Extra Category Name</th>
              <th>Image</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            
            <!-- <% extraCategories.map((item, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                
                <td><%= item.category_id ? item.category_id.category_name : 'No Category' %></td>
                <td><%= item.subCategory_id ? item.subCategory_id.subCategory_name : 'No SubCategory' %></td>
                
                <td><strong><%= item.extraCategory_name %></strong></td>
                <td>
                  <div class="extracategory-img-wrapper">
                    <img src="/uploads/extraCategories/<%= item.extraCategory_image %>" alt="Extra Category Image" />
                  </div>
                </td>
                <td>
                  <a href="/extraCategory/editExtraCategory/<%= item._id %>" class="modern-btn btn-edit">
                    <i class="bx bx-edit-alt"></i>
                  </a>
                  <a href="/extraCategory/deleteExtraCategory/<%= item._id %>" class="modern-btn btn-delete">
                    <i class="bx bx-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %> -->
                <% if (extraCategories && extraCategories.length > 0) { %>
    
                <% extraCategories.forEach((item, index) => { %>
      <tr>
        <td><%= index + 1 %></td>

         <td><%= item.category_id ? item.category_id.category_name : 'No Category' %></td>
                <td><%= item.subCategory_id ? item.subCategory_id.subCategory_name : 'No SubCategory' %></td>

        <td><strong><%= item.extraCategory_name %></strong></td>

        <td>
          <div class="extracategory-img-wrapper">
            <img src="/uploads/extraCategories/<%= item.extraCategory_image %>" alt="Extra Category Image" />
          </div>
        </td>

        <td>
          <a href="/extraCategory/editExtraCategory/<%= item._id %>" class="modern-btn btn-edit">
            <i class="bx bx-edit-alt"></i>
          </a>
          <a href="/extraCategory/deleteExtraCategory/<%= item._id %>" class="modern-btn btn-delete">
            <i class="bx bx-trash"></i>
          </a>
        </td>
      </tr>
    <% }) %>

  <% } else { %>
    
    <tr>
      <td colspan="6" class="text-center py-5">
        <i class="bx bx-list-plus text-muted mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
        <h5 class="fw-bold text-muted">No Extra Categories Found!</h5>
      </td>
    </tr>

  <% } %>

          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>