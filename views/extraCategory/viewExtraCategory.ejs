<%- include('../layouts/header') %>

<style>
  .modern-btn {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 35px !important;
      height: 35px !important;
      padding: 0 !important;
      border-radius: 8px !important;
      border: none !important;
      transition: all 0.3s ease;
      text-decoration: none !important;
  }

  /* Icon Size Control */
  .modern-btn i {
      font-size: 1.2rem !important;
      line-height: 0 !important;
  }

  /* EDIT Button (Light Blue Theme) */
  .btn-edit {
      background-color: rgba(105, 108, 255, 0.15) !important;
      color: #696cff !important;
  }
  
  .btn-edit:hover {
      background-color: #696cff !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(105, 108, 255, 0.4);
  }

  /* DELETE Button (Light Red Theme) */
  .btn-delete {
      background-color: rgba(255, 62, 29, 0.15) !important;
      color: #ff3e1d !important;
  }
  
  .btn-delete:hover {
      background-color: #ff3e1d !important;
      color: #fff !important;
      transform: translateY(-3px);
      box-shadow: 0 4px 8px rgba(255, 62, 29, 0.4);
  }
</style>

<div class="content-wrapper">
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">View Extra Categories</h4>

    <div class="card">
      <h5 class="card-header">Extra Category List</h5>
      
      <div class="table-responsive text-nowrap">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>SR.No</th>
              <th>Category Name</th>
              <th>Sub Category Name</th>
              <th>Extra Category Name</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            
            <% extraCategories.map((item, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                
                <td><%= item.category_id ? item.category_id.category_name : 'No Category' %></td>
                <td><%= item.subCategory_id ? item.subCategory_id.subCategory_name : 'No SubCategory' %></td>
                
                <td><strong><%= item.extraCategory_name %></strong></td>
                
                <td>
                  <a href="/extraCategory/editExtraCategory/<%= item._id %>" class="modern-btn btn-edit">
                    <i class="bx bx-edit-alt"></i>
                  </a>
                  <a href="/extraCategory/deleteExtraCategory/<%= item._id %>" class="modern-btn btn-delete">
                    <i class="bx bx-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %>

          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>